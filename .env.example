# Copy this file to .env and fill in real values. .env is already in
# .gitignore, so it never gets committed - safe to put real credentials here.
#
# For docker-compose: this file is picked up automatically, no extra steps.
# For a manual `mvn spring-boot:run`: your terminal/IDE needs to actually
# load these as real environment variables (a .env file by itself does
# nothing outside of docker-compose) - see the README's "Running locally
# without Docker" section.

# --- Database ---
DB_USERNAME=abrar
DB_PASSWORD=abrar

# --- Default librarian account, created on first run ---
LIBRARIAN_USERNAME=librarian
LIBRARIAN_EMAIL=librarian@bookstore.local
LIBRARIAN_PASSWORD=change-this-password

# --- Used to build links in verification/password-reset emails ---
APP_BASE_URL=http://localhost:8081

# --- Mail (needed for email verification and password-reset emails to
# actually be delivered; without these the app still works, tokens are
# still created, but delivery silently fails - use the admin panel to
# verify/reset accounts manually instead) ---
# Gmail requires an App Password here, not your normal account password:
# https://myaccount.google.com/apppasswords (needs 2-Step Verification on
# first).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=sxawra1997@gmail.com
MAIL_PASSWORD=cwkcjbjtrileifpc
MAIL_SSL_ENABLE=false