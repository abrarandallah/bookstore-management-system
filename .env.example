# BookStore settings for Docker.
#
# How to use: copy this file to a new file named ".env" in the same folder
#   Windows Command Prompt:  copy .env.example .env
#   PowerShell / Mac / Linux: cp .env.example .env
# then edit the values you care about in ".env". Every line below already has
# a working default, so you can leave any of them as they are.
# Never share your real ".env" file - it is kept out of git on purpose.

# --- Database -------------------------------------------------------------
DB_USERNAME=abrar
# CHANGE THIS before the site is reachable from the internet.
DB_PASSWORD=abrar

# --- First librarian (admin) account, created automatically on first start --
LIBRARIAN_USERNAME=librarian
LIBRARIAN_EMAIL=librarian@bookstore.local
# CHANGE THIS before the site is reachable from the internet.
LIBRARIAN_PASSWORD=change-this-password

# --- Links inside emails ----------------------------------------------------
# The address people type to reach the site. Change it when you deploy.
APP_BASE_URL=http://localhost:8081

# --- Email sending (verification + password reset emails) ------------------
# Leave MAIL_USERNAME / MAIL_PASSWORD empty and emails are not delivered
# (the links are still written to the app log). With Gmail, use an
# "App password", not your normal password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# If your network blocks port 587, set MAIL_PORT=465 and MAIL_SSL_ENABLE=true
MAIL_SSL_ENABLE=false

# --- Debugging ----------------------------------------------------------------
# Set to true to print every database query in the app log (very noisy).
SHOW_SQL=false
